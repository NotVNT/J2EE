# ============================================================
# MONEYMANAGER - COMPREHENSIVE .gitignore
# Purpose: Exclude secrets & private data while keeping all source code
# Last Updated: May 5, 2026
# ============================================================

# ============================================================
# 🔐 CRITICAL: Secrets & Environment (NEVER COMMIT)
# ============================================================

# Environment Variable Files
.env
.env.local
.env.*.local
.env.development.local
.env.production.local
.env.test.local
.env.backup
.env.*.backup

# Configuration files with actual credentials (not templates!)
# NOTE: .env.example SHOULD BE COMMITTED as a template
Backend/moneymanager/.env
Backend/moneymanager/application*.properties
Backend/moneymanager/application-*.properties
!Backend/moneymanager/application.properties.example

Frontend/.env
Frontend/.env.local

Mobile/.env
Mobile/.env.local

# 🤖 AI Service Credentials (SENSITIVE)
gemini.config
gemini*.properties
**/gemini/**/*.key
**/gemini/**/*.secret
**/config/gemini/

# 💳 Payment Gateway (PayOS) Credentials
payos.config
payos*.properties
**/payos/**/*.key
**/payos/**/*.secret
**/config/payos/

# 📧 Email Service (Brevo) Credentials
brevo.config
brevo*.properties
brevo.env
**/brevo/**/*.password
**/brevo/**/*.key
**/config/brevo/

# 🗄️ Database Credentials
db.config
database*.properties
**/db/**/*.password
**/jdbc.properties

# Other API Keys & Credentials
*.secret
*.apikey
*.key
*.pem
*.pfx
*.p12
*.jks
secrets.json
**/secrets/
credential*.json
**/credentials.json


