# ============================================================
# ⚠️ IMPORTANT: Project-Specific Exclusions
# ============================================================

# Backend - Local configurations (not .env)
Backend/moneymanager/logs/
Backend/moneymanager/*.log

# Frontend - Local build artifacts only (code IS included)
Frontend/.next/
Frontend/out/
Frontend/.vercel

# Mobile - Expo local cache
Mobile/.expo/
Mobile/.expo-shared/
Mobile/dist/
Mobile/ios/Pods/
Mobile/android/.gradle/
Mobile/android/local.properties
Mobile/android/build/

# React Native / Expo specific
Mobile/android/app/debug.keystore
Mobile/android/gradle/wrapper/gradle-wrapper.jar
Mobile/.expo/

# Database - Only exclude dumps and backups, not migrations
database_exports/
backup_databases/

# IDE - Only config, not project files
.editorconfig.local


# ============================================================
# 📝 IMPORTANT: What NOT to Ignore (INCLUDE in Repo)
# ============================================================

# ✅ DO COMMIT THESE:
# - All .java source files (Backend/)
# - All .jsx/.js React components (Frontend/)
# - All .js React Native components (Mobile/)
# - All configuration templates (.env.example)
# - Build configuration (pom.xml, package.json, Dockerfile)
# - ESLint config, Tailwind config, Babel config
# - Database migration scripts (Backend/db/migrations/)
# - README.md and documentation
# - GitHub Actions workflows (.github/workflows/)
# - .editorconfig for consistency
# - Project-wide .gitignore (this file)
# - mvnw, mvnw.cmd (Maven wrapper)
# - gradle wrapper files

# ❌ DO NOT COMMIT:
# - .env with actual values (only .env.example)
# - API keys, credentials, passwords
# - node_modules/, target/, .gradle/
# - IDE cache (.idea/, .vscode/ except extensions.json)
# - OS files (.DS_Store, Thumbs.db)
# - Build artifacts (*.class, *.jar from target/)
# - Database backup files
# - Local configuration files


# ============================================================
# ⚠️ RULE: When in Doubt, Exclude It
# Better to protect a credential than expose it
# ============================================================

# CI/CD & Deployment temporary files
*.tmp.json
*.backup.yml
deployment.log

# System generated files
.~*
*.tmp~
*._*

